DirectoryIndex index.html

# HTML pages should revalidate so browsers pick up new builds after deploy.
# /_next/static/* uses content hashes → safe to cache long-term.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, private, must-revalidate"
  </FilesMatch>

  SetEnvIf Request_URI "^/_next/static/.*" BALON_ADMIN_NEXT_STATIC=1
  Header set Cache-Control "public, max-age=31536000, immutable" env=BALON_ADMIN_NEXT_STATIC
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect non-trailing-slash URLs to trailing slash (matches Next.js trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # Dynamic detail routes: serve the static-export placeholder "_" page.
  # Client React still reads the real id from the browser URL.
  # Skip when the request already resolved to a real file (e.g. employees/index.html),
  # otherwise a second rewrite pass would steal the list page into employees/_/.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^employees/[^/]+/?$ /employees/_/index.html [L]

  # Legacy /news/:id/ bookmarks → query-param editor
  RewriteRule ^news/([0-9]+)/?$ /news/edit/?id=$1 [R=301,L]

  # Serve folder index.html for clean URLs
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

